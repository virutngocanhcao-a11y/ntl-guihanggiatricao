# Mat khau dang nhap trang /admin
ADMIN_PASSWORD=doi-mat-khau-nay

# GTG CRM - lay tu doi CRM, form se forward lead sang day
GTG_CRM_ENDPOINT=https://your-gtg-crm-domain.com/api/leads
GTG_CRM_API_KEY=your-api-key

# Cloudflare R2 (S3-compatible) - luu content.json + anh upload tu trang admin
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=ntl-guihanggiatricao
# URL public de xem anh/content.json (bat Public Access hoac custom domain cho bucket)
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
